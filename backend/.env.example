# Oxford Integration Configuration

# API Configuration
PORT=3000
API_URL=http://localhost:3000
PUBLIC_APP_URL=https://your-domain.com

# Google OAuth & Calendar
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://your-domain.com/api/oxford/calendar/google/oauth/callback
GOOGLE_CALENDAR_ID=primary
GOOGLE_GMAIL_MEALS_QUERY=label:Meals

# Acuity Scheduling
ACUITY_USER_ID=your_acuity_user_id
ACUITY_API_KEY=your_acuity_api_key
ACUITY_WEBHOOK_SECRET=change_me

# Squarespace Commerce
SQUARESPACE_API_KEY=your_squarespace_api_key
SQUARESPACE_SITE_ID=your_squarespace_site_id
SQUARESPACE_WEBHOOK_SECRET=change_me

# GroupMe Community
GROUPME_BOT_ID=your_groupme_bot_id
GROUPME_GROUP_ID=your_groupme_group_id
GROUPME_TOKEN=your_groupme_token

# Storage
FILES_DIR=./files